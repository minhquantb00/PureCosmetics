{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/auth/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },
      "email-route": {
        "ClusterId": "email-cluster",
        "Match": { "Path": "/email/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/email" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "d1": { "Address": "https://localhost:5039/" }
        }
      },
      "email-cluster": {
        "Destinations": {
          "d1": { "Address": "https://localhost:5147/" }
        }
      }
    }
  }
}
